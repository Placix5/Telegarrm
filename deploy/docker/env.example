# Rutas y usuario de Telegarrm en Docker. Cópialo como .env junto a compose.yaml y cámbialo si hace
# falta. Aquí NO van las claves: van en archivos dentro de TELEGARRM_SECRETS (ver docs/instalacion-docker.md).

# Usuario y grupo con el que corre (el dueño de la biblioteca; Jellyfin usa el mismo). Mira el tuyo con «id».
PUID=1000
PGID=1000

# Datos de Telegarrm: base de datos, sesión de Telegram y contraseña de la web
TELEGARRM_DATA=/opt/docker/telegarrm/db

# Carpeta con los archivos de las claves: telegram_api_id, telegram_api_hash y tmdb_token
TELEGARRM_SECRETS=/opt/docker/telegarrm/secretos

# Biblioteca: búfer de descargas, películas y series. Se monta con la misma ruta dentro del contenedor.
MEDIA_DIR=/srv/media

# Puerto de la web en el servidor
TELEGARRM_PORT=8080

# Versión de la imagen: latest, o una concreta (sha-1a2b3c4) para no actualizar sin querer
TELEGARRM_TAG=latest

TZ=Europe/Madrid
