// Regla de polkit para Telegarrm: el usuario plax puede arrancar, parar y reiniciar
// telegarrm.service sin sudo (para desplegar versiones nuevas durante el desarrollo).
// No da ningún otro permiso: ni sobre otras unidades ni para habilitar o modificar esta.
// Se instala en /etc/polkit-1/rules.d/ (ver README, "Como servicio").
polkit.addRule(function (action, subject) {
    if (action.id === "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") === "telegarrm.service" &&
        subject.user === "plax") {
        var verb = action.lookup("verb");
        if (verb === "start" || verb === "stop" || verb === "restart") {
            return polkit.Result.YES;
        }
    }
    return polkit.Result.NOT_HANDLED;
});
